{
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch -c *)",
      "Bash(git checkout -b *)",
      "Bash(git push -u origin *)",
      "Bash(gh pr create *)",
      "Bash(gh pr view *)",
      "Bash(npm test *)",
      "Bash(npm run *)",
      "Bash(npx playwright test *)"
    ],
    "ask": [
      "Bash(git reset --hard *)",
      "Bash(rm -rf *)"
    ],
    "deny": [
      "Bash(gh pr merge *)",
      "Bash(gh pr review *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push * main)",
      "Bash(git push * master)"
    ]
  }
}
