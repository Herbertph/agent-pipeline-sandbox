{
  "name": "agent-pipeline-sandbox",
  "version": "0.1.0",
  "private": true,
  "description": "Sandbox for a multi-agent Claude Code pipeline: requirements, dev, QA, PR",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
